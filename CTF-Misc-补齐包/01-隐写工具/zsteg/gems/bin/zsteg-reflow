#!/bin/sh
# -*- ruby -*-
_=_\
=begin
bindir="${0%/*}"
ruby="$bindir/ruby"
if [ ! -f "$ruby" ]; then
  ruby="ruby"
fi
exec "$ruby" "-x" "$0" "$@"
=end
#!D:/XiaoMibook/CTF学习/CTF-Misc-补齐包/01-隐写工具/zsteg/ruby/bin/ruby.exe
#
# This file was generated by RubyGems.
#
# The application 'zsteg' is installed as part of a gem, and
# this file is here to facilitate running it.
#

require 'rubygems'

Gem.use_gemdeps

version = ">= 0.a"

str = ARGV.first
if str
  str = str.b[/\A_(.*)_\z/, 1]
  if str and Gem::Version.correct?(str)
    version = str
    ARGV.shift
  end
end

if Gem.respond_to?(:activate_bin_path)
load Gem.activate_bin_path('zsteg', 'zsteg-reflow', version)
else
gem "zsteg", version
load Gem.bin_path("zsteg", "zsteg-reflow", version)
end
